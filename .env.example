# Dev Brain Environment Variables

# Local-first LLM (OpenAI-compatible: llama.cpp / Ollama /v1).
# All /api/gemini/* handlers call this first; Gemini is only the fallback.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=minicpm5-fable
# Set to 1 to force the old Gemini-only behaviour.
# DISABLE_LOCAL_LLM=0
LOCAL_LLM_TIMEOUT_MS=300000

# Cloud fallback (optional; used only when the local server is unavailable
# or returns unusable output).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# Jev (System One) decision engine — calibrated choice/noul/score over a state.
# Two-tier chain: tier 1 = Vercel AI Gateway TypeSafe lane (TYPESAFE_BASE_URL +
# a key), tier 2 = LocalJev on :8080 (JEV_LOCAL_BASE_URL, no key). Gateway first
# when a key is configured; any gateway failure falls back to localjev. Both down
# => source:'offline'. The deterministic matrix stays authoritative; Jev adds an
# advisory ranking (POST /api/decide/jev, GET /api/jev/status).
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=typesafe-ai/jev
# JEV_LOCAL_BASE_URL=http://127.0.0.1:8080
# JEV_LOCAL_MODEL=jev-latest
# DEV_BRAIN_JEV_ENABLED=1
# JEV_TIMEOUT_MS=10000
